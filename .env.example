# Copy to .env for local overrides. Never commit .env.
STORAGE_BACKEND=local          # local | memory | postgres
# DATA_DIR=data/vault          # where the local backend keeps its files
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # for STORAGE_BACKEND=postgres (e.g. Neon)
MAX_UPLOAD_BYTES=4194304
MIN_PASSPHRASE_LENGTH=10
WINDOW_SECONDS=300
TZ_OFFSET_HOURS=0              # your UTC offset, so "night access" uses local time

# --- Online-guessing protection (defaults shown; lockout is derived from the audit log) ---
# RATE_LIMIT_MAX_FAILURES=5          # failed unlock/MFA attempts per client per window
# RATE_LIMIT_WINDOW_SECONDS=300
# LOCKOUT_SECONDS=60                 # first lockout; later ones grow x5 up to the cap
# RATE_LIMIT_GLOBAL_MAX_FAILURES=20  # backstop across all clients (proxy case)
# LOCKOUT_MAX_SECONDS=900            # hard cap: the owner is never locked out for good

# --- Sessions ---
# Generate your own long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit it. Unset = random per-process secret (sessions then end on restart).
SESSION_SECRET=
# SESSION_TTL_SECONDS=900            # absolute session lifetime
# SESSION_IDLE_SECONDS=300           # inactivity timeout
# REAUTH_WINDOW_SECONDS=300          # how long a verified code counts as "recent"

# Set to true ONLY on a shared public demo: turns off passphrase change and two-step verification setup
DEMO_MODE=false
